# Gmail account used to send lead notifications (Google SMTP)
GMAIL_USER=your_account@gmail.com

# Gmail App Password (16 chars, NOT your normal password).
# Requires 2-Step Verification enabled: https://myaccount.google.com/apppasswords
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx

# Destination inbox for all lead notifications (defaults to info@nixinn.com if unset)
NOTIFICATION_EMAIL=info@nixinn.com
